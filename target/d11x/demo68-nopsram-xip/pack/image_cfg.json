{
    "spi-nor": { // Device, The name should be the same with string in image:info:media:type
        "size": "16m", // Size of SPI NOR
        "partitions": {
            "spl":        { "size": "512k" },
            "os":         { "size": "3m" },
            "rodata":     { "size": "4m" },
        },
    },
    "image": {
        "info": { // Header information about image
            "platform": "d11x",
            "product": "demo68-nopsram-xip",
            "version": "1.0.0",
            "media": {
                "type": "spi-nor",
                "device_id": 0,
            }
        },
        "updater": { // Image writer which is downloaded to RAM by USB/UART
            "spl": {
                "file": "bootloader.aic",
                "attr": ["required", "run"],
                "ram": "0x30043000"
            },
        },
        "target": { // Image components which will be burn to device's partitions
            "spl": {
                "file": "bootloader.aic",
                "attr": ["mtd", "required"],
                "part": ["spl"]
            },
           "os": {
              "file": "d11x_os.aic",
              "attr": ["mtd", "required"],
              "part": ["os"]
           },
           "rodata": {
               "file": "rodata.fatfs",
               "attr": ["mtd", "optional"],
               "part": ["rodata"]
           },
        },
    },
    "pre-process": { // Pre-proccess to generate image components from raw data
        "aicimage": { // Create aic boot image
            "bootloader.aic": {
                "head_ver": "0x00010001",
                "loader": {
                    "file": "bootloader_with_uart_upgrade.bin", // Use UART upgrade
                    //"file": "bootloader_with_sdcard_upgrade.bin", // Use SDCARD upgrade
                    "load address": "0x30043000",
                    "entry point": "0x30043100", // 256 byte aic header
                },
                "resource": {
                    "private": "pbp_cfg.bin",
                },
            },
            "d11x_os.aic": {
                "head_ver": "0x00010001",
                "loader": {
                    "file": "d11x.bin",
                    "load address": "0x60080000",
                    "entry point": "0x60080100", // 256 byte aic header
                },
                "resource": {
                    "private": "pbp_cfg.bin",
                },
            },
        },
    },
}

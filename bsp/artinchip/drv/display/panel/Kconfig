config AIC_PANEL_CUSTOM_RESOLUTION
    bool "Custom Display Timing"
    depends on AIC_SIMPLE_PANEL
    default n

choice
        prompt "Classic Resolution List"
        depends on AIC_SIMPLE_PANEL
        depends on !AIC_PANEL_CUSTOM_RESOLUTION
        default AIC_PANEL_1024X600

    config AIC_PANEL_480X272
        bool "480x272"
        depends on AIC_DISP_RGB

    config AIC_PANEL_800X480
        bool "800x480"
        depends on AIC_DISP_RGB

    config AIC_PANEL_1024X600
        bool "1024x600"
        depends on AIC_DISP_RGB || AIC_DISP_LVDS

    config AIC_PANEL_H050A21
        bool "h050a21"
        depends on AIC_DISP_RGB

    config AIC_PANEL_H068B06
        bool "h068b06"
        depends on AIC_DISP_RGB

    config AIC_PANEL_H070A20
        bool "h070a20"
        depends on AIC_DISP_RGB

    config AIC_PANEL_H086A01
        bool "h086a01"
        depends on AIC_DISP_RGB

    config AIC_PANEL_1920X1080_RESOLUTION
        bool "1920x1080"
        depends on AIC_DISP_LVDS
endchoice

config RGB_PANEL_MATCH_ID
    int
    default 0 if AIC_PANEL_1024X600
    default 1 if AIC_PANEL_800X480
    default 2 if AIC_PANEL_480X272
    default 3 if AIC_PANEL_H050A21
    default 4 if AIC_PANEL_H068B06
    default 5 if AIC_PANEL_H070A20
    default 6 if AIC_PANEL_H086A01
    default 7 if AIC_PANEL_CUSTOM_RESOLUTION


config LVDS_PANEL_MATCH_ID
    int
    default 0 if AIC_PANEL_1024X600
    default 1 if AIC_PANEL_1920X1080_RESOLUTION
    default 2 if AIC_PANEL_CUSTOM_RESOLUTION

choice
    prompt "ILI9881C Match Table"
    depends on AIC_PANEL_DSI_ILI9881C
    default ILI9881C_DEFAULT

    config ILI9881C_DEFAULT
        bool "default 4 lane 800x1280"
    config TFT050BP071_DEFAULT
        bool "tft050bp071 2 lane 720"
endchoice

config ILI9881C_MATCH_ID
    int
    default 0 if ILI9881C_DEFAULT
    default 1 if TFT050BP071_DEFAULT

choice
    prompt "ST7789 Match Table"
    depends on AIC_PANEL_DBI_ST7789
    default ST7789_P3

    config ST7789_P3
        bool "P3 I8080 240x320"
    config ST7789_T3
        bool "T3 SPI 4LINE 240x320"
    config ST7789_V3
        bool "V3 SPI 4LINE 240x320"
endchoice

config ST7789_MATCH_ID
    int
    default 0 if ST7789_P3
    default 1 if ST7789_T3
    default 2 if ST7789_V3

config ST7789_PANEL_RESET
    string "ST7789 display panel reset pin"
    depends on AIC_PANEL_DBI_ST7789
    default "PD.23"

choice
    prompt "LT9811EXB Resolution List"
    depends on AIC_PANEL_DSI_EDP_LT9811EXB
    default LT9811EXB_1920X1080

    config LT9811EXB_1920X1200
        bool "1920x1200"
    config LT9811EXB_1920X1080
        bool "1920x1080"
    config LT9811EXB_1366X768
        bool "1366x768"
endchoice

config LT9811EXB_RESOLUTION
    depends on AIC_PANEL_DSI_EDP_LT9811EXB
    int
    default 0 if LT9811EXB_1920X1200
    default 1 if LT9811EXB_1920X1080
    default 2 if LT9811EXB_1366X768

if AIC_PANEL_SPI_GENERAL
config SPI_GENERAL_WIDTH
    int "SPI LCD Width"
    default 160

config SPI_GENERAL_HEIGHT
    int "SPI LCD Height"
    default 160
endif

if AIC_PANEL_CUSTOM_RESOLUTION && !AIC_DISP_PQ_TOOL
source "bsp/artinchip/drv/display/panel/Kconfig.timing"
endif

config AIC_SIMPLE_PANEL_POWER_GPIO
    bool "simple panel power control via GPIO"
    depends on AIC_SIMPLE_PANEL
    default n
    help
        Enable simple panel power control using a fixed GPIO pin.
        This GPIO pin does not need to registered in pinmux.c file.
        Say Y if simple panel needs to apply a dedicated power enable GPIO.

if AIC_SIMPLE_PANEL_POWER_GPIO

config AIC_SIMPLE_PANEL_POWER_GPIO_PIN
    string "panel power GPIO pin"
    default "PE.13"
    help
        Specify the GPIO pin used for simple panel power control.
        Format: "PX.NN" (e.g., "PE.20", "PA.5")

config AIC_SIMPLE_PANEL_POWER_GPIO_LOW_ACTIVE
    bool "power control GPIO is low active"
    default n
    help
        Say Y here if the GPIO needs to be driven low to enable LCD power,
        and high to disable. If unsure, say N (default high active).

config AIC_SIMPLE_PANEL_POWER_DELAY_MS
    int "panel power on delay (ms)"
    default 0
    range 0 1000
    help
        Delay in milliseconds after enabling power before
        initializing the panel. Some panels require stabilization time.
endif

endmenu

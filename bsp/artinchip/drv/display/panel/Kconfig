
menu "Display Panels"

    choice
        prompt "ArtInChip Panel Drivers"
        default AIC_SIMPLE_PANEL

#
# Simple Panel
#
    config AIC_SIMPLE_PANEL
        bool "ArtInChip SIMPLE panel"
        depends on AIC_DISP_RGB || AIC_DISP_LVDS
        help
            Simple Panel support general RGB or LVDS LCD


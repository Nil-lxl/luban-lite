#-----------------------------
# aic8800 wlan devices local parameter
#-----------------------------

# wlan0 parameter

menu "Wlan0 Parameter"

    choice
        prompt "Select AIC8800 MODEL"
        default CHIP_SELECT_AIC8800D40L
        config CHIP_SELECT_AIC8800D40L
            bool "select AIC8800D40L"
        config CHIP_SELECT_AIC8800DW
            bool "select AIC8800DW"
        config CHIP_SELECT_AIC8800DL
            bool "select AIC8800DL"
        config CHIP_SELECT_AIC8800M40B
            bool "select AIC8800M40B"
    endchoice

    choice
        prompt "Select AIC8800 power converter"
        default CONFIG_AIC8800_VRF_DCDC_MODE
        config CONFIG_AIC8800_VRF_DCDC_MODE
            bool "select DCDC mode"
        config CONFIG_AIC8800_VRF_LDO_MODE
            bool "select LDO mode"
    endchoice

    choice
        prompt "Select AIC8800 work mode"
        default CONFIG_AIC8800_NORMAL_MODE
        config CONFIG_AIC8800_NORMAL_MODE
            bool "select normal mode"
        config CONFIG_AIC8800_RFTEST_MODE
            bool "select rftest mode"
        config CONFIG_AIC8800_FTTEST_MODE
            bool "select fttest mode"
    endchoice

    config CONFIG_AIC8800_MAC_USE_CHIP_ID
        bool "enable aic8800 mac use chip id"
        default n
        select AIC_USING_SID
        select AIC_MAC_CHIPID_DRV

    config CONFIG_AIC8800_BT_SUPPORT
        bool "enable aic8800 BT support"
        default n

    config AIC_DEV_AIC8800_DEBUG_LOG
        bool "enable aic8800 debug messages"
        default y

endmenu

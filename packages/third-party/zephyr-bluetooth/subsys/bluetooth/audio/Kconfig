menuconfig LPKG_BT_AUDIO
	bool "Bluetooth Audio support"
	depends on UTF8
	help
	  This option enables Bluetooth Audio support. The specific
	  features that are available may depend on other features
	  that have been enabled in the stack, such as Periodic
	  Advertisement for Broadcast and L2CAP Dynamic Channel
	  for Unicast.

if LPKG_BT_AUDIO

config LPKG_BT_AUDIO_RX
	bool
    default y if (LPKG_BT_ASCS_ASE_SNK || LPKG_BT_BAP_UNICAST_CLIENT_ASE_SRC || LPKG_BT_BAP_BROADCAST_SINK)

config LPKG_BT_AUDIO_TX
	bool
    default y if (LPKG_BT_ASCS_ASE_SRC || LPKG_BT_BAP_UNICAST_CLIENT_ASE_SNK || LPKG_BT_BAP_BROADCAST_SOURCE)

config LPKG_BT_AUDIO_NOTIFY_RETRY_DELAY
	int "Delay for notification sending retried attempt in 1.25 ms units"
	range 6 3200
	default 20
	help
	  This option sets the time in 1.25 ms units before the stack will
	  retry to send notification that failed due to lack of TX buffers
	  available.


Import('AIC_ROOT')
Import('PRJ_OUT_DIR')
Import('PRJ_KERNEL')
from building import *

cwd = GetCurrentDir()
path = [cwd + '/spienc-authorization']

src = []
group = []

PATH = AIC_ROOT + '/packages/artinchip/aic-spienc-authorization/spienc-authorization/'
prj_chip = GetDepend('PRJ_CHIP').strip('"')

LOCAL_CCFLAGS = ''
# LOCAL_CCFLAGS += ' -O0'

# spienc authorization
if GetDepend('LPKG_USING_AIC_SPIENC_AUTHORIZATION'):
    lib_name = 'aic_spienc_authorization_' + prj_chip + '.a'

    if os.path.exists(PATH + 'spienc_authorization.c'):
        src += Glob('./spienc-authorization/*.c')
        DefineGroup(PATH + lib_name, src, depend = [''], LIBRARY='')

if GetDepend(['AIC_SPIENC_AUTHORIZATION_TEST']):
    src += Glob('./test/*.c')

group = DefineGroup('aic-spienc-authorization', src, depend=['LPKG_USING_AIC_SPIENC_AUTHORIZATION'],
                   CPPPATH = path, LIBS = ['aic_spienc_authorization_' + prj_chip], LIBPATH = [PATH], LOCAL_CCFLAGS=LOCAL_CCFLAGS)

Return('group')
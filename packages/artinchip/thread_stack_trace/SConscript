Import('AIC_ROOT')
Import('PRJ_KERNEL')
from building import *

cwd = GetCurrentDir()
CPPPATH = [cwd]

src = ['thread_stack_trace.c']

my_cflags = ' -w'
group = DefineGroup('thread_stack_trace', src, depend = ['AIC_USING_THREAD_STACK_TRACE'], CPPPATH =
        CPPPATH, LOCAL_CFLAGS = my_cflags)

Return('group')

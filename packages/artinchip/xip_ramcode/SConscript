Import('AIC_ROOT')
Import('PRJ_KERNEL')
from building import *

cwd = GetCurrentDir()
CPPPATH = [cwd]

src = []

if GetDepend('AIC_XIP_FLASH_WRITE') and GetDepend('AIC_CHIP_D13X'):
    src += Glob('xip_ramcode_d13x_bin.c')
if GetDepend('AIC_XIP_FLASH_WRITE') and GetDepend('AIC_CHIP_D12X'):
    src += Glob('xip_ramcode_d12x_bin.c')

group = DefineGroup('xip', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
